{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonyLab",
  "version": "0.1.0",
  "identifier": "com.sonylab.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @sonylab/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @sonylab/web",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [{ "title": "SonyLab", "width": 1440, "height": 900 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
